{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions des fenêtres (principale et conversion rapide) : rien de plus que nécessaire.",
  "windows": [
    "main",
    "quick"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        }
      ]
    }
  ]
}
